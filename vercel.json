{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "app/api/ai/council/route.ts": {
      "maxDuration": 300
    },
    "app/api/ai/chat/route.ts": {
      "maxDuration": 60
    },
    "app/api/face-analysis/runs/[id]/analyze/route.ts": {
      "maxDuration": 120
    },
    "app/api/face-analysis/runs/[id]/upload/route.ts": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/cron/cleanup-pending-orders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/cleanup-face-images",
      "schedule": "15 * * * *"
    }
  ]
}
