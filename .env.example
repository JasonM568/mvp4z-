NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

SUPABASE_SERVICE_ROLE_KEY=

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# 巽風易學決策報告（council）｜多重分身校核
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
ENABLE_DEBATE_ROUND=true
COUNCIL_CREDIT_COST=10
# 可選：覆寫各分身的 system prompt（留空則用程式碼預設）
OPENAI_FENGYI_SYSTEM_PROMPT=
GEMINI_FENGYI_SYSTEM_PROMPT=
DEEPSEEK_ATTACK_SYSTEM_PROMPT=
FENGYI_FINAL_SYSTEM_PROMPT=

# 面相子系統：品質與 Vision 服務必須是組織核准、禁止訓練／零保留的後端服務。
# 未設定或 FACE_VISION_ZERO_RETENTION 不為 true 時，系統採 fail-closed，不會產生假報告。
FACE_ANALYSIS_ENABLED=false
NEXT_PUBLIC_FACE_ANALYSIS_ENABLED=false
FACE_QUALITY_PROVIDER_URL=
FACE_QUALITY_PROVIDER_TOKEN=
FACE_VISION_PROVIDER_URL=
FACE_VISION_PROVIDER_TOKEN=
FACE_VISION_MODEL=
FACE_VISION_ZERO_RETENTION=false
FACE_REPORT_MODEL=gpt-4.1-mini
CRON_SECRET=

ECPAY_ENV=sandbox
ECPAY_MERCHANT_ID=
ECPAY_HASH_KEY=
ECPAY_HASH_IV=
ECPAY_RETURN_URL=http://localhost:3000/api/payments/ecpay/return
ECPAY_NOTIFY_URL=http://localhost:3000/api/payments/ecpay/notify
ECPAY_CLIENT_BACK_URL=http://localhost:3000/member

ECPAY_INVOICE_ENV=stage
ECPAY_INVOICE_MERCHANT_ID=
ECPAY_INVOICE_HASH_KEY=
ECPAY_INVOICE_HASH_IV=

ADMIN_EMAILS=

# Email 寄送（Resend）。用於：註冊成功信、付款通知信、開票失敗 admin alert。
# 需先在 Resend 驗證寄件網域（xunfeng.tw）才能用 noreply@xunfeng.tw 寄信。
# 未設 RESEND_API_KEY 時所有寄信會 skip、不阻斷主流程。
RESEND_API_KEY=
RESEND_FROM_EMAIL=巽風系統 <noreply@xunfeng.tw>
ADMIN_ALERT_EMAILS=
